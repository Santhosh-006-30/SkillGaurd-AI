# SkillGuard AI Environment Configuration
PROJECT_NAME="SkillGuard AI"
VERSION="1.0.0"

# Database Configuration (SQLite for MVP, PostgreSQL compatible)
DATABASE_URL="sqlite:///./backend/skillguard.db"

# Authentication & Security
JWT_SECRET="replace_with_strong_random_secret_in_production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION=1440

# File Storage Paths
UPLOAD_DIR="./backend/uploads"
EVIDENCE_DIR="./backend/evidence"
MODEL_PATH="./ai_models"
MAX_UPLOAD_SIZE=209715200

# Computer Vision & Inference Thresholds
PERSON_CONFIDENCE=0.50
EQUIPMENT_CONFIDENCE=0.40
FRAME_SKIP=3
OBSERVATION_WINDOW=300

# Low-Bandwidth & Edge Options
LOW_BANDWIDTH_MODE=false
OFFLINE_BUFFER_LIMIT=5000
